# Copy to .env and fill in. Never commit .env. No spaces, no quotes.
GEMINI_API_KEY=paste-your-new-key-here
GEMINI_MODEL=gemini-2.5-flash-lite

# Your website address(es), comma separated (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173

# Limits to protect your quota
RATE_LIMIT_PER_MINUTE=10
DAILY_LIMIT=500

# Set true only when running behind a proxy you trust (Render, Railway, nginx)
TRUST_PROXY=false
